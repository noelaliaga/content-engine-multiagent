# Copy to .env and fill in locally. Never commit .env.
# Only needed for --live runs; the offline demo needs nothing.

# Your OpenRouter API key.
OPENROUTER_API_KEY=

# Optional: use this OpenRouter model id for every step (overrides engine/config/models.json).
CONTENT_ENGINE_MODEL=

# Optional: another OpenAI-compatible Chat Completions base URL.
OPENROUTER_BASE_URL=
